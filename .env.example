# ============================================
# PostgreSQL Superset (метаданные Superset)
# ============================================
# Полная строка подключения для Superset метаданных
DATABASE_URL=postgresql://postgres:password@host:port/database

# Или отдельные параметры (если нужны)
SUPERSET_POSTGRES_HOST=host
SUPERSET_POSTGRES_PORT=5432
SUPERSET_POSTGRES_USER=postgres
SUPERSET_POSTGRES_PASSWORD=password
SUPERSET_POSTGRES_DB=database

# ============================================
# Superset API (для экспорта/импорта метаданных)
# ============================================
# URL Superset
SUPERSET_URL=http://localhost:8088
# Или для Railway/удаленного сервера:
# SUPERSET_URL=https://your-app.railway.app

# Учетные данные для Superset API
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# ============================================
# Основная база данных (Ubidex Events)
# ============================================
# Если используется отдельная БД для данных приложения
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ubidex
POSTGRES_PASSWORD=ubidex
POSTGRES_DB=ubidex

# ============================================
# Redis (для кеширования Superset)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ============================================
# Другие настройки
# ============================================
DB_TYPE=postgresql
SUPERSET_SECRET_KEY=your-secret-key-change-in-production
EXPORT_DIR=superset_export
